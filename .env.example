# ===== Obrigatórios =====
# App Meta: developers.facebook.com/apps → seu app → Configurações → Básico
META_APP_ID=
META_APP_SECRET=

# Token e conta do Instagram: rode "npm run token -- SEU_TOKEN" que ele preenche os dois
META_ACCESS_TOKEN=
IG_USER_ID=

# Agendador online (Cloudflare). "npm run deploy" preenche WORKER_URL sozinho.
# WORKER_API_KEY: o instalador gera uma chave aleatória.
WORKER_URL=
WORKER_API_KEY=

# ===== Opcionais =====
# Seu nome, usado nas regras de comentários (ex: Maria)
DONO_NOME=

# Pasta do Google Drive (app Google Drive para computador) onde ficam os carrosséis.
# Ex: G:\Meu Drive\Criação de Conteúdo\Corretagem\Carrosseis
DRIVE_DIR=

# Calendário do Google Agenda para os lembretes (nome e, se souber, o id)
GOOGLE_AGENDA_NOME=Agenda Instagram
GOOGLE_AGENDA_ID=

# Pasta que o botão "Nova postagem" do painel abre no VS Code (padrão: esta pasta)
VSCODE_PROJETO=

# Porta do painel (padrão 3333) e versão da Graph API
PAINEL_PORTA=3333
GRAPH_VERSION=v21.0
POSTS_DIR=./posts
